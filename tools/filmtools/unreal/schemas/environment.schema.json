    {
     "type": "null"
    }
   ],
   "description": "sky_light"
  },
  "hdri": {
   "anyOf": [
    {
     "type": "object",
     "description": "hdri",
     "additionalProperties": false,
     "properties": {
      "cubemap": {
       "description": "a TextureCube path (an .hdr imported as a long-lat cubemap)"
      },
      "intensity": {
       "description": "sky light scale"
      },
