      "film_white_clip": {},
      "fringe": {},
      "gain": {},
      "gamma": {},
      "grain": {},
      "lut": {},
      "lut_intensity": {},
      "offset": {},
      "preset": {
       "enum": [
        "bleach_bypass",
        "clean",
        "documentary",
        "golden_hour",
        "high_contrast",
        "moonlight",
        "neutral",
        "noir_bw",
        "pastel",
        "teal_orange",
        "vintage_fade",
        "warm_film"
