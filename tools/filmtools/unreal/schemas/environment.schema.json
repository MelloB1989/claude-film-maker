       },
       "intensity_cd": {
        "description": "see envlib/lights.py: canonical light"
       },
       "intensity_lux": {
        "description": "see envlib/lights.py: canonical light"
       },
       "kind": {
        "description": "see envlib/lights.py: canonical light"
       },
       "label": {
        "description": "see envlib/lights.py: canonical light"
       },
       "loc": {
