{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://claude-film-maker/schemas/environment.schema.json",
 "title": "environment spec",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "kind"
 ],
 "properties": {
  "kind": {
   "const": "environment"
  },
  "version": {
   "const": 1
  },
  "name": {
   "type": "string",
   "description": "owner name: prune scope"
  },
  "description": {
   "type": "string"
  },
  "mood": {
   "type": [
    "string",
    "null"
   ],
   "description": "the mood to apply (a key of moods)"
  },
  "prune": {
   "type": "boolean",
   "description": "remove what this spec made earlier and no longer asks for"
  },
  "checks": {
   "type": "object",
   "description": "env.check: {camera, targets} (envlib/stats.py check targets)"
  },
  "lights": {
   "type": "object",
   "additionalProperties": {
    "anyOf": [
     {
      "type": "object",
      "additionalProperties": false,
