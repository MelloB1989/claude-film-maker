      },
      "saturation": {},
      "scene_color_tint": {},
      "scene_fringe_intensity": {},
      "tint": {},
      "vignette": {},
      "vignette_intensity": {},
      "white_balance": {},
      "white_temp": {},
      "white_tint": {}
