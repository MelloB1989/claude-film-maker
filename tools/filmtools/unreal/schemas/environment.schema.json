      "compensation": {
       "description": "stops brighter (+) or darker (-)"
      },
      "fstop": {
       "description": "physical: aperture"
      },
      "shutter_s": {
       "description": "physical: shutter time, s"
      },
      "iso": {
       "description": "physical: ISO"
      },
      "min_ev100": {
       "description": "auto: the darkest scene EV100 it adapts to"
      },
      "max_ev100": {
       "description": "auto: the brightest"
      },
      "speed": {
       "description": "auto: adaptation speed (stops/s)"
      }
     }
    },
    {
     "type": "boolean",
     "const": false
    },
    {
     "type": "null"
    }
   ],
   "description": "exposure"
  },
  "grade": {
   "anyOf": [
