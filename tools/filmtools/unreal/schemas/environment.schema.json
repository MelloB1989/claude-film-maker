     {
      "type": "boolean",
      "const": false
     },
     {
      "type": "null"
     }
    ],
    "description": ""
   },
   "description": "label -> light"
  },
  "practicals": {
   "type": "object",
   "additionalProperties": {
    "anyOf": [
     {
      "type": "object",
