       },
       "barn_door_deg": {
        "description": "see envlib/lights.py: canonical light"
       },
       "barn_door_length_cm": {
        "description": "see envlib/lights.py: canonical light"
       },
       "channels": {
        "description": "see envlib/lights.py: canonical light"
       },
       "color": {
        "description": "see envlib/lights.py: canonical light"
       },
       "cone_deg": {
        "description": "see envlib/lights.py: canonical light"
       },
       "diffuse": {
        "description": "see envlib/lights.py: canonical light"
       },
       "height_cm": {
        "description": "see envlib/lights.py: canonical light"
       },
       "ies": {
        "description": "see envlib/lights.py: canonical light"
       },
       "ies_brightness": {
        "description": "see envlib/lights.py: canonical light"
       },
       "indirect": {
        "description": "see envlib/lights.py: canonical light"
       },
       "inner_cone_deg": {
        "description": "see envlib/lights.py: canonical light"
       },
       "intensity_cd": {
        "description": "see envlib/lights.py: canonical light"
       },
       "intensity_lux": {
        "description": "see envlib/lights.py: canonical light"
       },
       "kind": {
        "description": "see envlib/lights.py: canonical light"
       },
       "label": {
        "description": "see envlib/lights.py: canonical light"
       },
       "loc": {
        "description": "see envlib/lights.py: canonical light"
       },
       "look_at": {
        "description": "see envlib/lights.py: canonical light"
       },
       "lumens": {
        "description": "see envlib/lights.py: canonical light"
       },
       "lux": {
        "description": "see envlib/lights.py: canonical light"
       },
       "nits": {
        "description": "see envlib/lights.py: canonical light"
       },
       "radius_cm": {
        "description": "see envlib/lights.py: canonical light"
       },
       "role": {
        "description": "see envlib/lights.py: canonical light"
       },
       "rotation": {
        "description": "see envlib/lights.py: canonical light"
       },
       "shadows": {
        "description": "see envlib/lights.py: canonical light"
       },
       "soft_radius_cm": {
        "description": "see envlib/lights.py: canonical light"
       },
       "softness_deg": {
        "description": "see envlib/lights.py: canonical light"
       },
       "source_length_cm": {
        "description": "see envlib/lights.py: canonical light"
       },
       "source_radius_cm": {
        "description": "see envlib/lights.py: canonical light"
       },
