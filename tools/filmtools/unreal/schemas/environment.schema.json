  },
  "rigs": {
   "type": "object",
   "additionalProperties": {
    "anyOf": [
     {
      "type": "object",
      "description": "a lighting rig",
      "additionalProperties": false,
      "properties": {
       "subject": {
        "description": "an actor label or [x,y,z] cm"
       },
       "subject_offset": {
        "description": "[x,y,z] cm added (e.g. eye height)"
       },
       "socket": {
        "description": "a socket/bone on the subject's skeletal mesh to light (e.g. 'head')"
       },
       "camera": {
        "description": "a camera label or [x,y,z]"
       },
       "facing_yaw_deg": {
        "description": "the subject's facing when there is no camera"
       },
       "preset": {
        "description": "a rig preset (env.presets: rigs)"
       },
       "key_lux": {
        "description": "lux on the subject from the key"
       },
       "ratio": {
        "description": "lighting ratio (key+fill):fill"
       },
       "lights": {
        "description": "per-role overrides {role: {...} | null}"
       },
       "key_side": {
        "description": "left|right (camera-left/right)"
       },
       "scale": {
        "description": "x distances and sizes"
       },
       "temperature_k": {
        "description": "every light's kelvin"
       },
       "channels": {
        "description": "lighting channels for every light"
       }
      }
     },
     {
      "type": "boolean",
      "const": false
     },
     {
      "type": "null"
     }
    ],
    "description": "a lighting rig"
   },
   "description": "name -> rig; its lights are labelled <name>_<Role>"
  },
  "channels": {
   "type": "object",
   "additionalProperties": {
    "type": "array",
    "items": {
     "enum": [
      0,
      1,
      2
     ]
    }
   },
   "description": "actor label -> lighting channels"
  },
  "preset": {
   "enum": [
    "exterior_blue_hour",
    "exterior_day",
    "exterior_golden",
    "exterior_night",
    "exterior_overcast",
    "interior_day",
    "interior_night",
    "studio_black",
    "studio_grey"
   ],
   "description": "a base environment"
  },
  "sun": {
   "anyOf": [
    {
     "type": "object",
     "description": "sun",
     "additionalProperties": false,
     "properties": {
      "time": {
       "description": "local time 'HH:MM', decimal hours, or a named time of day (env.presets: times)"
      },
      "lat": {
       "description": "latitude, degrees north"
      },
      "lon": {
       "description": "longitude, degrees east"
      },
      "date": {
       "description": "YYYY-MM-DD"
      },
      "tz": {
       "description": "time zone, hours east of UTC"
      },
      "elevation_deg": {
       "description": "sun elevation above the horizon (overrides time)"
      },
      "azimuth_deg": {
       "description": "compass azimuth, degrees clockwise from north"
      },
      "north_yaw_deg": {
       "description": "the level yaw of geographic north (0 = +X)"
      },
      "intensity_lux": {
       "description": "illuminance; 'auto' = 120000 with an atmosphere (it attenuates), else by elevation"
      },
      "temperature_k": {
       "description": "colour temperature; 'auto' = 6500 with an atmosphere (it tints), else by elevation"
      },
      "softness_deg": {
       "description": "the sun's angular diameter (shadow softness), 0.5357 is the real sun"
      },
      "channels": {
       "description": "lighting channels [0..2]"
      },
      "cloud_shadows": {
       "description": "cast shadows from volumetric clouds"
      }
     }
    },
    {
     "type": "boolean",
     "const": false
    },
    {
     "type": "null"
    }
   ],
   "description": "sun"
  },
  "moon": {
   "anyOf": [
    {
     "type": "object",
     "description": "moon",
     "additionalProperties": false,
     "properties": {
      "elevation_deg": {
       "description": "moon elevation"
      },
      "azimuth_deg": {
       "description": "compass azimuth"
      },
      "north_yaw_deg": {
       "description": "level yaw of north"
      },
      "intensity_lux": {
       "description": "illuminance (full moon ~0.25; stylised night 0.5-2)"
      },
      "temperature_k": {
       "description": "kelvin"
      },
      "softness_deg": {
       "description": "angular size"
      },
      "channels": {
       "description": "lighting channels"
      }
     }
    },
    {
     "type": "boolean",
     "const": false
    },
    {
     "type": "null"
    }
   ],
   "description": "moon"
  },
  "atmosphere": {
   "anyOf": [
    {
     "type": "object",
     "description": "atmosphere",
     "additionalProperties": false,
     "properties": {
      "preset": {
       "description": "clear|crisp|hazy|smoggy|dusty"
      },
      "haze": {
       "description": "x Mie scattering (aerosols)"
      },
      "rayleigh": {
       "description": "x Rayleigh scattering (sky blueness)"
      },
      "aerial_distance_scale": {
       "description": "x aerial perspective"
      },
      "mie_anisotropy": {
       "description": "0-1 forward scattering of haze"
      },
      "ground_albedo": {
       "description": "[r,g,b] linear"
      },
      "multi_scattering": {
       "description": "multi-scattering factor"
      },
      "height_fog_contribution": {
       "description": "0-1"
      }
     }
    },
    {
     "type": "boolean",
     "const": false
    },
    {
     "type": "null"
    }
   ],
   "description": "atmosphere"
  },
