      },
      "emissive": {
       "description": "volumetric emissive [r,g,b]"
      }
     }
    },
    {
     "type": "boolean",
     "const": false
    },
    {
     "type": "null"
    }
   ],
   "description": "fog"
  },
  "exposure": {
   "anyOf": [
    {
     "type": "object",
     "description": "exposure",
     "additionalProperties": false,
     "properties": {
      "mode": {
       "description": "manual|physical|auto"
      },
      "ev100": {
       "description": "the scene EV100 to expose for, or 'auto' (from the key light / sun)"
