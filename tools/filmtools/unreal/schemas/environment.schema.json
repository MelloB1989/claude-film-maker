      },
      "color": {
       "description": "inscattering [r,g,b] linear"
      },
      "volumetric": {
       "description": "bool: volumetric fog (light shafts)"
      },
      "albedo": {
       "description": "volumetric albedo [r,g,b]"
      },
      "extinction": {
       "description": "volumetric extinction scale"
      },
      "distance_cm": {
       "description": "volumetric fog view distance"
      },
      "scattering": {
