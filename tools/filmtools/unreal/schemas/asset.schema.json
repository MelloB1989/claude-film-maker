{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "asset",
 "description": "A file on the box imported to a content path (WP2), with its mesh build settings, texture role and metadata tags. Converged by assets.import / assets.mesh / assets.texture / assets.tag.",
 "type": "object",
 "required": ["kind", "file", "dest"],
 "additionalProperties": false,
 "properties": {
  "kind": {"const": "asset"},
  "version": {"type": "integer", "const": 1},
  "name": {"type": "string", "description": "unique name of this document"},
  "description": {"type": "string", "description": "free text"},
  "file": {"type": "string", "description": "the source file's absolute path ON THE BOX (fbx, obj, gltf, glb, abc, usd, png, exr, wav, ...)"},
  "dest": {"type": "string", "pattern": "^/[A-Za-z0-9_]+/", "description": "content folder, e.g. /Game/Set/Props"},
  "asset": {"type": "string", "description": "the asset's name in dest (default: the file's stem); the planner checks this path"},
  "reimport": {"type": "boolean", "default": false, "description": "import again on every apply (a changed file with the same name)"},
  "import": {
   "type": "object",
   "additionalProperties": false,
   "description": "assets.import options",
   "properties": {
    "kind": {"type": "string", "enum": ["static", "skeletal", "auto", "geometry_cache"], "description": "what the mesh becomes"},
    "skeleton": {"type": "string", "description": "Skeleton content path for skeletal meshes/animations"},
    "scale": {"type": "number", "description": "uniform import scale (after the source's units are converted to cm)"},
    "combine": {"type": "boolean", "description": "merge an FBX's parts into one static mesh"},
    "nanite": {"type": "boolean", "description": "build Nanite at import"},
    "collision": {"type": "string", "enum": ["none", "box", "sphere", "capsule", "convex", "convex10", "convex26"], "description": "simple collision generated at import"},
    "lods": {"type": "boolean", "description": "import the file's LODs"},
    "materials": {"type": "boolean", "description": "import the file's materials"},
    "textures": {"type": "boolean", "description": "import the file's textures"},
    "animations": {"type": "boolean", "description": "import animations"},
    "groom": {"type": "boolean", "description": "an Alembic of hair curves becomes a Groom"},
    "abc_preset": {"type": "string", "enum": ["maya", "max", "none"], "description": "Alembic axis conversion"}
   }
  },
  "mesh": {
   "type": "object",
   "additionalProperties": false,
   "description": "assets.mesh build settings (static meshes)",
   "properties": {
    "nanite": {"type": "boolean", "description": "Nanite on/off"},
    "nanite_keep_percent": {"type": "number", "minimum": 0, "maximum": 100, "description": "percent of triangles Nanite keeps"},
    "lods": {"type": "integer", "minimum": 1, "maximum": 8, "description": "number of LODs (generated by reduction)"},
    "lod_percents": {"type": "array", "items": {"type": "number"}, "description": "percent of triangles kept per LOD"},
    "collision": {"type": "string", "enum": ["none", "box", "sphere", "capsule", "convex", "ndop10", "ndop18", "ndop26"], "description": "simple collision"},
    "convex_hulls": {"type": "integer", "minimum": 1, "description": "hull count for convex collision"},
    "lightmap_uv": {"type": "boolean", "description": "generate lightmap UVs"},
    "cpu_access": {"type": "boolean", "description": "allow CPU access"},
    "lod_group": {"type": "string", "description": "LOD group name (LargeProp, SmallProp, ...)"}
   }
  },
  "texture_role": {"type": "string", "enum": ["base_color", "normal", "roughness", "gloss", "metallic", "ao", "orm", "opacity", "height", "emissive", "specular", "translucency", "cavity", "fuzz", "hdr"], "description": "a texture's role: sets sRGB and compression (assets.texture)"},
  "tags": {"type": "object", "description": "metadata tags {key: value} (assets.tag), searchable with assets.find tags="}
 }
}
