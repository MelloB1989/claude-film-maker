# each film's generated and paid audio (tools/): voice takes, the score, the mix and the sound library's takes are
# rebuilt or re-downloaded, never committed; films/<id>/audio/sfx/manifest.json and vo/selects.json are
films/*/audio/vo/takes/
films/*/audio/vo/paced/
films/*/audio/vo/vo.wav
films/*/audio/vo/vo-chain.wav
films/*/audio/music/
films/*/audio/mix/
films/*/audio/sfx/lib/
films/*/audio/sfx/*.wav
# test shots' tracks (blender/render.py)
films/*/data/track/_*.json

# agent worktrees
.claude/worktrees/
build/

# The Rain Ferry's v1 AI material (generated keyframes, clips, layers), its VRoid Studio projects and its generated
# audio stay local; the Blender film's shot references are assets/ref/, its cast assets/vroid/*.vrm
films/rain-ferry/assets/gen/
films/rain-ferry/assets/clips/
films/rain-ferry/assets/layers/
films/rain-ferry/assets/vroid/*.vroid
films/rain-ferry/audio/**/*.wav
