{
  "id": "lighthouse-keeper",
  "title": "Your Life As a Lighthouse Keeper",
  "format": "landscape",
  "fps": 24,
  "theme": {
    "extends": "paper",
    "bg": "#0d0e13",
    "bg2": "#15171f"
  },
  "audio": {
    "mix": "audio/mix/mix.wav",
    "analysis": "data/audio.json",
    "bpm": 76.0,
    "offset": 0,
    "beatsPerBar": 4
  },
  "vo": "data/vo.json",
  "pipeline": {
    "voice": {
      "provider": "elevenlabs",
      "name": "George",
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
